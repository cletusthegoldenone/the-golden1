# The Golden1 — environment variable reference
# Copy this file to .env and fill in real values before running locally or deploying.
# DO NOT commit .env to source control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Jupiter fee routing ──────────────────────────────────────────────────────
# Destination wallet for the 0.5% (50 bps) fee on every authorised trade.
# Default set in src/config.js; override here if needed.
# JUPITER_FEE_WALLET=h1vRxwsCLUtiD6UiKpSgNnTDUAqvXCxurFVUfvH1noj

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set to "true" to activate the global kill switch on startup (all trading blocked).
# KILL_SWITCH_ON_STARTUP=false

# ─── Policy / legal versioning ────────────────────────────────────────────────
# Bump these values after every policy change to invalidate stale consent records.
# POLICY_VERSION_TERMS=2026-08-19
# POLICY_VERSION_RISK_DISCLAIMER=2026-08-19
# POLICY_VERSION_TRADING_AUTHORIZATION=2026-08-19
# POLICY_VERSION_PRIVACY=2026-08-19

# ─── Persistence (future / placeholder) ──────────────────────────────────────
# DATABASE_URL=******localhost:5432/thegolden1
# REDIS_URL=redis://localhost:6379

# ─── Auth / security (future / placeholder) ──────────────────────────────────
# JWT_SECRET=change_me_before_production
# SESSION_SECRET=change_me_before_production

# ─── Rate limiting (future / placeholder) ────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
