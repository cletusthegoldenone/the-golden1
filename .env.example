# Server
# On Railway, PORT is injected automatically — do not set it manually.
PORT=3000

# Node environment — set to "production" on Railway
NODE_ENV=development

# Session/auth hardening
SESSION_SECRET=replace-with-strong-random-secret
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=tg1_session
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=Strict
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
AUTH_PROVIDER=bootstrap
AUTH_CHALLENGE_TTL_SECONDS=120
AUTH_REQUIRE_SECURE_TRANSPORT=false
AUTH_BOOTSTRAP_TOKEN=replace-with-bootstrap-token

# Durable persistence adapter
# Set PERSISTENCE_ADAPTER=postgres and DATABASE_URL on Railway to use PostgreSQL.
PERSISTENCE_ADAPTER=file
PERSISTENCE_FILE_PATH=./data/the-golden1-state.json
# Railway PostgreSQL plugin automatically sets DATABASE_URL in the service environment.
DATABASE_URL=
# Optional migration source file for: node src/migrateState.js
MIGRATION_SOURCE_FILE=

# Rate limits
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PROTECTED_MAX=120
RATE_LIMIT_PROTECTED_WINDOW_MS=60000

# Request size controls
MAX_BODY_BYTES=1048576

# Legal/consent policy versions
POLICY_VERSION_TERMS=2026-08-19
POLICY_VERSION_RISK=2026-08-19
POLICY_VERSION_TRADING_AUTH=2026-08-19
POLICY_VERSION_PRIVACY=2026-08-19

# Trading policy engine
TRIAL_DAYS=30
MONTHLY_GROSS_PROFIT_CAP_USD=10000
WEEKLY_PASS_USDC=20
FEE_ROUTING_ENABLED=true
FEE_ROUTING_BPS=50
JUPITER_FEE_WALLET=GJwtCupMcNGbhGX1vapg2ueK2pedx2tgMkzGjhugnxaA

# ── Solana / Helius RPC ───────────────────────────────────────────────────────
# Helius API key — used for transaction submission, self-healing RPC, and wallet
# inspection. Get yours at https://helius.dev
HELIUS_API_KEY=

# Optional: explicit custom Helius RPC URL (constructed from HELIUS_API_KEY if absent)
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Fallback public RPC (used when Helius is unavailable)
RPC_URL=https://api.mainnet-beta.solana.com

# Priority fee in lamports — the self-healing engine escalates this automatically
PRIORITY_FEE_LAMPORTS=100000

# ── Jupiter Aggregator ────────────────────────────────────────────────────────
# Paid-tier key grants higher rate limits and priority routing.
# Without a key the free public API (quote-api.jup.ag/v6) is used.
# Get yours at https://portal.jup.ag
JUPITER_API_KEY=

# ── Trading Wallet ────────────────────────────────────────────────────────────
# Server-side private key for autonomous trade execution.
# Supports base58 string (Phantom export) or JSON byte array ([...]).
# NEVER commit this value. Leave blank for dry-run / simulation mode.
TRADING_WALLET_PRIVATE_KEY=

# ── Admin Authentication ──────────────────────────────────────────────────────
# Admin wallet address — only this wallet can access protected routes.
ADMIN_WALLET_ADDRESS=GJwtCupMcNGbhGX1vapg2ueK2pedx2tgMkzGjhugnxaA

# Admin PIN for kill-switch and emergency endpoints (4-6 digits)
ADMIN_PIN=

# Admin recovery code (backup access if PIN is lost)
ADMIN_RECOVERY_CODE=

# ── RugCheck.xyz — token safety audit ────────────────────────────────────────
# Pre-trade security scan: tokens scoring above MAX_AUDIT_RISK_SCORE are blocked.
# Get your key at https://rugcheck.xyz
RUGCHECK_API_KEY=
RUGCHECK_MIN_SCORE=500
RUGCHECK_BLOCK_ON_ERROR=false
# Maximum risk score to allow a trade (0–100, default 69)
MAX_AUDIT_RISK_SCORE=69

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Trade Fees ────────────────────────────────────────────────────────────────
# Percentage fee deducted from each trade on close (e.g. 1.0 = 1%)
TRADE_FEE_PERCENT=1.0

# Wallet address where trade fees are collected (owner/treasury wallet)
FEE_WALLET_ADDRESS=GJwtCupMcNGbhGX1vapg2ueK2pedx2tgMkzGjhugnxaA

# ── Trading Parameters & Signals ─────────────────────────────────────────────
MIN_MARKET_CAP=25000
MAX_MARKET_CAP=1000000000
MIN_VOLUME_USD=5000
SLIPPAGE_TOLERANCE=0.05
MAX_POSITION_SIZE_USD=5000
MAX_OPEN_POSITIONS=5
MIN_COMPOSITE_SCORE=0.65

# Signal weights (should sum to 1.0 — self-learning engine adjusts over time)
SIGNAL_VOLUME_SPIKE_WEIGHT=0.15
SIGNAL_MOMENTUM_WEIGHT=0.15
SIGNAL_BREAKOUT_WEIGHT=0.12
SIGNAL_RSI_WEIGHT=0.12
SIGNAL_MACD_WEIGHT=0.12
SIGNAL_HOLDER_GROWTH_WEIGHT=0.15
SIGNAL_LIQUIDITY_BUILD_WEIGHT=0.10
SIGNAL_SOCIAL_WEIGHT=0.09

# ── SEC Compliance Thresholds ─────────────────────────────────────────────────
SEC_MAX_VOLUME_SHARE=0.05
SEC_MAX_LIQUIDITY_SHARE=0.10
SEC_WASH_TRADE_WINDOW_MINUTES=60
SEC_MAX_TRADES_PER_5MIN=8
SEC_DEFAULT_SOL_PRICE_USD=180

# ── Operating Schedule ────────────────────────────────────────────────────────
ENABLE_24_7_TRADING=false
TRADING_START_TIME=09:00
TRADING_END_TIME=17:00
TRADING_TIMEZONE=America/New_York
PAUSE_ON_WEEKENDS=true

# ── Profit & Loss Management ──────────────────────────────────────────────────
STOP_LOSS_PERCENTAGE=10.0
TAKE_PROFIT_PERCENTAGE=25.0
ENABLE_TRAILING_STOP=true
TRAILING_STOP_PERCENTAGE=5.0

# ── Daily / Weekly / Monthly Targets ─────────────────────────────────────────
DAILY_PNL_TARGET=5000
DAILY_LOSS_LIMIT=-2000
WEEKLY_PNL_TARGET=30000
WEEKLY_LOSS_LIMIT=-10000
MONTHLY_PNL_TARGET=100000
MONTHLY_LOSS_LIMIT=-30000

# ── Risk Management ───────────────────────────────────────────────────────────
RISK_PER_TRADE_PERCENTAGE=2.0
MAX_TOTAL_EXPOSURE_PERCENTAGE=25.0
MAX_DRAWDOWN_PERCENTAGE=15.0
ENABLE_RECOVERY_MODE=true
RECOVERY_MODE_AGGRESSION_MULTIPLIER=0.5

# ── Market Filters ────────────────────────────────────────────────────────────
MIN_TOKEN_AGE_HOURS=1
MAX_HOLDER_CONCENTRATION=0.30
MAX_HOURLY_PRICE_MOVEMENT=50.0
REQUIRE_LIQUIDITY_LOCK=true

# ── Feature Flags ─────────────────────────────────────────────────────────────
# MUST be true AND TRADING_WALLET_PRIVATE_KEY must be set for real swaps.
# Without the private key the system records positions in dry-run mode regardless.
ENABLE_LIVE_TRADING=false
ENABLE_AI_BRAIN=true
ENABLE_KILL_SWITCH=true
FEATURE_LEGAL_GATE=true
FEATURE_DUAL_WALLET=true
FEATURE_TAX_CENTER=true
FEATURE_WHITELIST_BLOCKLIST=true

# ── Logging & Debugging ───────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_ALL_SIGNALS=false
LOG_POSITION_CHANGES=true
ENABLE_SIMULATION_MODE=false
ENABLE_DRY_RUN=false

# ── Optional: Staking & Token (Coming Soon) ───────────────────────────────────
# CLETUS_TOKEN_ADDRESS=
# STAKING_PROGRAM_ID=

# ── Optional: Monitoring & Alerts ────────────────────────────────────────────
# DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/xxx
# ALERT_EMAIL=your-email@example.com
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx


# Rate limits
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PROTECTED_MAX=120
RATE_LIMIT_PROTECTED_WINDOW_MS=60000

# Request size controls
MAX_BODY_BYTES=1048576

# Legal/consent policy versions
POLICY_VERSION_TERMS=2026-08-19
POLICY_VERSION_RISK=2026-08-19
POLICY_VERSION_TRADING_AUTH=2026-08-19
POLICY_VERSION_PRIVACY=2026-08-19

# Trading policy engine
TRIAL_DAYS=30
MONTHLY_GROSS_PROFIT_CAP_USD=10000
WEEKLY_PASS_USDC=20
FEE_ROUTING_ENABLED=true
FEE_ROUTING_BPS=50
JUPITER_FEE_WALLET=GJwtCupMcNGbhGX1vapg2ueK2pedx2tgMkzGjhugnxaA

# Helius RPC — operator's paid endpoint for transaction submission with rebate routing
HELIUS_API_KEY=

# RugCheck.xyz — token safety audit API (paid operator service)
# Tokens scoring below RUGCHECK_MIN_SCORE are blocked before trade execution.
# Score range is 0-1000; 500 is a reasonable safe threshold.
# Set RUGCHECK_BLOCK_ON_ERROR=true to block trades when the API is unreachable.
RUGCHECK_API_KEY=
RUGCHECK_MIN_SCORE=500
RUGCHECK_BLOCK_ON_ERROR=false

# Feature flags
FEATURE_LEGAL_GATE=true
FEATURE_DUAL_WALLET=true
FEATURE_TAX_CENTER=true
FEATURE_WHITELIST_BLOCKLIST=true

# AI chat (Cletus)
GEMINI_API_KEY=
